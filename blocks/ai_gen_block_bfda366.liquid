{% doc %}
  Product details accordion — single-open, brutalist styling.

  CONTENT SOURCES
  Tabs 1-3 (What's in the box / Description / Dimensions), first match wins:
    1. Product metafield   custom.box_contents | custom.info_description | custom.dimensions  (optional per-product override)
    2. Collection metafield with the same keys (first collection of the product that has it)
    3. Fallback content set in this block's settings (leave empty to hide the tab)

  Tabs 4-5 (Returns & refunds / Shipping policy):
    - Written once in this block's settings, OR
    - Pulled automatically from Settings > Policies when the matching checkbox is on.

  A tab with no label or no content is not rendered.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-accordion-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: #111111;
    font-family: "Space Mono", monospace;
    text-align: left;
  }

  /* TITLE */
  .ai-accordion-{{ ai_gen_id }}__title {
    margin: 0 0 28px;
    padding: 0;
    color: #111111;
    font-family: "Space Mono", monospace;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: left;
  }

  /* ITEMS */
  .ai-accordion-{{ ai_gen_id }}__item {
    border-top: 2px solid #111111;
    background: #ffffff;
    text-align: left;
  }

  .ai-accordion-{{ ai_gen_id }}__item:last-child {
    border-bottom: 2px solid #111111;
  }

  /* TRIGGER */
  .ai-accordion-{{ ai_gen_id }}__trigger {
    width: 100%;
    min-height: 64px;
    padding: 18px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 0;
    background: #ffffff;
    color: #111111;
    font-family: "Space Mono", monospace;
    font-size: {{ block.settings.item_size }}px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-align: left;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .ai-accordion-{{ ai_gen_id }}__trigger:hover {
    background: rgba(14, 14, 14, 0.05);
    color: #111111;
  }

  .ai-accordion-{{ ai_gen_id }}__trigger:focus-visible {
    outline: 3px solid #111111;
    outline-offset: 3px;
  }

  /* PLUS / MINUS ICON */
  .ai-accordion-{{ ai_gen_id }}__chevron {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    border: 2px solid #111111;
    background: #ffffff;
    transform: none;
    margin: 0;
  }

  .ai-accordion-{{ ai_gen_id }}__chevron::before,
  .ai-accordion-{{ ai_gen_id }}__chevron::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 2px;
    background: #111111;
    transform: translate(-50%, -50%);
  }

  .ai-accordion-{{ ai_gen_id }}__chevron::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* Open state */
  .ai-accordion-{{ ai_gen_id }}__trigger[aria-expanded="true"] {
    background: rgba(14, 14, 14, 0.05);
    color: #111111;
  }

  .ai-accordion-{{ ai_gen_id }}__trigger[aria-expanded="true"] .ai-accordion-{{ ai_gen_id }}__chevron {
    background: #111111;
  }

  .ai-accordion-{{ ai_gen_id }}__trigger[aria-expanded="true"] .ai-accordion-{{ ai_gen_id }}__chevron::before,
  .ai-accordion-{{ ai_gen_id }}__trigger[aria-expanded="true"] .ai-accordion-{{ ai_gen_id }}__chevron::after {
    background: #ffffff;
  }

  .ai-accordion-{{ ai_gen_id }}__trigger[aria-expanded="true"] .ai-accordion-{{ ai_gen_id }}__chevron::after {
    display: none;
  }

  /* CONTENT */
  .ai-accordion-{{ ai_gen_id }}__panel {
    padding: 20px 16px 24px;
    background: #ffffff;
    color: #111111;
    font-family: "Space Mono", monospace;
    font-size: {{ block.settings.content_size }}px;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0.01em;
    text-align: left;
  }

  .ai-accordion-{{ ai_gen_id }}__panel p {
    margin: 0 0 12px;
  }

  .ai-accordion-{{ ai_gen_id }}__panel p:last-child {
    margin-bottom: 0;
  }

  .ai-accordion-{{ ai_gen_id }}__panel ul,
  .ai-accordion-{{ ai_gen_id }}__panel ol {
    margin: 0 0 12px;
    padding-left: 22px;
  }

  .ai-accordion-{{ ai_gen_id }}__panel li {
    margin-bottom: 6px;
  }

  .ai-accordion-{{ ai_gen_id }}__panel a {
    color: #111111;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .ai-accordion-{{ ai_gen_id }}__panel a:hover {
    background: rgba(14, 14, 14, 0.05);
    text-decoration: none;
  }

  /* MOBILE */
  @media screen and (max-width: 749px) {
    .ai-accordion-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-accordion-{{ ai_gen_id }}__title {
      margin-bottom: 22px;
      font-size: min({{ block.settings.title_size }}px, 26px);
    }

    .ai-accordion-{{ ai_gen_id }}__trigger {
      min-height: 58px;
      padding: 16px 12px;
      font-size: min({{ block.settings.item_size }}px, 16px);
    }

    .ai-accordion-{{ ai_gen_id }}__panel {
      padding: 18px 12px 22px;
      font-size: min({{ block.settings.content_size }}px, 15px);
      line-height: 1.65;
    }

    .ai-accordion-{{ ai_gen_id }}__chevron {
      width: 16px;
      height: 16px;
      flex-basis: 16px;
    }

    .ai-accordion-{{ ai_gen_id }}__chevron::before,
    .ai-accordion-{{ ai_gen_id }}__chevron::after {
      width: 7px;
    }
  }
{% endstyle %}

{%- liquid
  # Metafield keys (namespace "custom") for tabs 1, 2 and 3, in order
  assign mf_keys = 'box_contents,info_description,dimensions' | split: ','
-%}

<single-open-accordion-{{ ai_gen_id }}
  class="ai-accordion-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h2 class="ai-accordion-{{ ai_gen_id }}__title">
      {{ block.settings.title | escape }}
    </h2>
  {% endif %}

  {% for i in (1..5) %}
    {%- liquid
      assign label_key = 'label_' | append: i
      assign content_key = 'content_' | append: i
      assign item_label = block.settings[label_key]
      assign item_content = block.settings[content_key]

      if i <= 3
        # Tabs 1-3: product override -> first collection that has data -> block fallback
        assign idx = i | minus: 1
        assign mf_key = mf_keys[idx]
                assign rendered = product.metafields.custom[mf_key] | metafield_tag

        if rendered != blank
          assign item_content = rendered
        else
          for c in product.collections
            assign rendered = c.metafields.custom[mf_key] | metafield_tag
            if rendered != blank
              assign item_content = rendered
              break
            endif
          endfor
        endif

      elsif i == 4
        assign item_content = '<p>Returns accepted only for damaged, defective, or incorrect products reported within 48 hours of delivery, with an unboxing video required for damage claims. No change-of-mind returns; personalized orders cannot be cancelled once production begins.</p><p><a href="/policies/refund-policy">Read the full policy →</a></p>'

      elsif i == 5
        assign item_content = '<p>We offer free shipping on orders above ₹499; otherwise, a standard shipping fee of ₹119 applies. Orders are processed within 1–3 business days and delivered within approximately 3–7 business days after dispatch.</p><p><a href="/policies/shipping-policy">Read the full policy →</a></p>'
      endif
    -%}

    {% if item_label != blank and item_content != blank %}
      <div class="ai-accordion-{{ ai_gen_id }}__item">

        <button
          class="ai-accordion-{{ ai_gen_id }}__trigger"
          type="button"
          aria-expanded="false"
          aria-controls="ai-accordion-panel-{{ ai_gen_id }}-{{ i }}"
          id="ai-accordion-trigger-{{ ai_gen_id }}-{{ i }}"
        >
          <span>{{ item_label | escape }}</span>
          <span class="ai-accordion-{{ ai_gen_id }}__chevron" aria-hidden="true"></span>
        </button>

        <div
          class="ai-accordion-{{ ai_gen_id }}__panel"
          id="ai-accordion-panel-{{ ai_gen_id }}-{{ i }}"
          role="region"
          aria-labelledby="ai-accordion-trigger-{{ ai_gen_id }}-{{ i }}"
          hidden
        >
          {{ item_content }}
        </div>

      </div>
    {% endif %}
  {% endfor %}
</single-open-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'single-open-accordion-{{ ai_gen_id }}';

    if (customElements.get(tagName)) return;

    class SingleOpenAccordion extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', (event) => {
          const button = event.target.closest('.ai-accordion-{{ ai_gen_id }}__trigger');
          if (!button || !this.contains(button)) return;

          const panel = this.querySelector('#' + CSS.escape(button.getAttribute('aria-controls')));
          const opening = button.getAttribute('aria-expanded') !== 'true';

          /* Close every item */
          this.querySelectorAll('.ai-accordion-{{ ai_gen_id }}__trigger').forEach((trigger) => {
            trigger.setAttribute('aria-expanded', 'false');
            const target = this.querySelector('#' + CSS.escape(trigger.getAttribute('aria-controls')));
            if (target) target.hidden = true;
          });

          /* Open the clicked item */
          if (opening && panel) {
            button.setAttribute('aria-expanded', 'true');
            panel.hidden = false;
          }
        });
      }
    }

    customElements.define(tagName, SingleOpenAccordion);
  })();
</script>

{% schema %}
{
  "name": "Product details accordion",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product information"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Tabs 1-3: from collection data"
    },
    {
      "type": "paragraph",
      "content": "Content comes from the product or collection metafields (box_contents, info_description, dimensions). The fields below are only a fallback when no metafield is filled in. Leave a fallback empty to hide that tab."
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "First label",
      "default": "What's in the box?"
    },
    {
      "type": "richtext",
      "id": "content_1",
      "label": "First fallback content"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Second label",
      "default": "Description"
    },
    {
      "type": "richtext",
      "id": "content_2",
      "label": "Second fallback content"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Third label",
      "default": "Dimensions"
    },
    {
      "type": "richtext",
      "id": "content_3",
      "label": "Third fallback content"
    },
    {
      "type": "header",
      "content": "Tabs 4-5: same for every product"
    },
    {
      "type": "text",
      "id": "label_4",
      "label": "Fourth label",
      "default": "Returns & refunds"
    },
    {
      "type": "checkbox",
      "id": "use_refund_policy",
      "label": "Use store refund policy",
      "info": "Pulls the text from Settings > Policies. Overrides the content below.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content_4",
      "label": "Fourth content",
      "default": "<p>Share your returns and refund information here.</p>"
    },
    {
      "type": "text",
      "id": "label_5",
      "label": "Fifth label",
      "default": "Shipping policy"
    },
    {
      "type": "checkbox",
      "id": "use_shipping_policy",
      "label": "Use store shipping policy",
      "info": "Pulls the text from Settings > Policies. Overrides the content below.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content_5",
      "label": "Fifth content",
      "default": "<p>Share your shipping policy here.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "item_size",
      "label": "Item text size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Content text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Product details accordion"
    }
  ],
  "tag": null,
  "class": "product-details-accordion"
}
{% endschema %}
