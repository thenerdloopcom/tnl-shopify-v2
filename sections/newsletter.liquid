<section class="newsletter">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2>{{ section.settings.heading }} <span>{{ section.settings.accent }}</span></h2>
  <p>{{ section.settings.text }}</p>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "STAY IN THE LOOP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "JOIN THE" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "RESISTANCE." },
    { "type": "text", "id": "text", "label": "Text", "default": "SIGN UP TO GET FLAT 10% OFF ON YOUR FIRST ORDER." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}