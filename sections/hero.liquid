<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>

    <h1>
      {{ section.settings.line_1 }}<br>
      <em>{{ section.settings.line_2 }}</em> <span>{{ section.settings.line_3 }}</span>
    </h1>

    <p class="hero-description">{{ section.settings.description }}</p>

    <div class="hero-cta">
      <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="comic-button">
        {{ section.settings.button_label }} ↗
      </a>
    </div>
  </div>

  {%- assign fallback_count = 0 -%}
  <div
    class="hero-art hero-carousel"
    data-hero-carousel
    data-autoplay="{{ section.settings.autoplay }}"
    data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  >
    {%- for block in section.blocks -%}
      <div class="hero-slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- if forloop.first -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.line_1 }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.line_1 }}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      {%- if section.settings.image != blank -%}
        <div class="hero-slide is-active">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.line_1 }}
        </div>
      {%- else -%}
        {%- comment -%} No slides added yet: auto-fill from the first 5 products so the carousel works out of the box. {%- endcomment -%}
        {%- for product in collections['all'].products limit: 5 -%}
          {%- if product.featured_image -%}
            <div class="hero-slide{% if fallback_count == 0 %} is-active{% endif %}">
              {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}
            </div>
            {%- assign fallback_count = fallback_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if fallback_count > 1 -%}
          <div class="hero-dots">
            {%- for i in (1..fallback_count) -%}
              <button type="button" class="hero-dot{% if forloop.first %} is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="Show slide {{ i }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- if section.blocks.size > 1 -%}
      <div class="hero-dots" role="tablist" aria-label="Hero slides">
        {%- for block in section.blocks -%}
          <button type="button" class="hero-dot{% if forloop.first %} is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="Show slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-hero-carousel]').forEach(function (root) {
      if (root.dataset.heroInit) return;
      root.dataset.heroInit = '1';

      var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-slide'));
      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-hero-dot]'));
      if (slides.length < 2) return;

      var delay = parseInt(root.dataset.delay, 10) || 5000;
      var autoplay = root.dataset.autoplay !== 'false';
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var current = 0;
      var timer = null;

      function show(i) {
        current = (i + slides.length) % slides.length;
        slides.forEach(function (s, n) { s.classList.toggle('is-active', n === current); });
        dots.forEach(function (d, n) { d.classList.toggle('is-active', n === current); });
      }

      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() {
        stop();
        if (!autoplay || reduce) return;
        timer = setInterval(function () { show(current + 1); }, delay);
      }

      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          show(parseInt(d.dataset.heroDot, 10));
          start();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      document.addEventListener('shopify:block:select', function (e) {
        var i = slides.indexOf(e.target);
        if (i > -1) { stop(); show(i); }
      });
      document.addEventListener('shopify:block:deselect', start);

      start();
    });
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DROP 002 / THE FANDOM COLLECTION" },
    { "type": "text", "id": "line_1", "label": "Headline line 1", "default": "GEAR FOR" },
    { "type": "text", "id": "line_2", "label": "Headline line 2 (italic)", "default": "THE" },
    { "type": "text", "id": "line_3", "label": "Headline line 2 (accent)", "default": "NERDS." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Handmade masks, metallic signs, and artifacts for the true fans. Built to last, designed to impress." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP THE DROP" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Fallback image (used only if no slides are added)" },
    { "type": "header", "content": "Carousel" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-scroll slides", "default": true },
    { "type": "range", "id": "autoplay_delay", "label": "Seconds per slide", "min": 3, "max": 8, "step": 1, "unit": "s", "default": 5 }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}