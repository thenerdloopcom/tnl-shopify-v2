{%- comment -%}
  Shop by collection — responsive grid of collections.
  Collections come only from the native collection_list picker (section.settings.collections).
  Optional blocks override the image of a collection that is already in the list.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign ls = s.title_spacing | divided_by: 100.0
  assign view_all_url = s.view_all_url | default: routes.collections_url
  assign heading_id = 'tnl-sbc-heading-' | append: section.id
-%}

<div
  class="tnl-sbc"
  data-hover="{{ s.hover_effect }}"
  style="
    --sbc-bg: {{ s.bg_color }};
    {%- if s.text_color != blank -%}--sbc-fg: {{ s.text_color }};{%- endif -%}
    --sbc-maxw: {{ s.max_width }}px;
    --sbc-gutter-d: {{ s.gutter_desktop }}px;
    --sbc-gutter-m: {{ s.gutter_mobile }}px;
    --sbc-gap-d: {{ s.gap_desktop }}px;
    --sbc-gap-m: {{ s.gap_mobile }}px;
    --sbc-cols-d: {{ s.cols_desktop }};
    --sbc-cols-t: {{ s.cols_tablet }};
    --sbc-cols-m: {{ s.cols_mobile }};
    --sbc-ratio: {{ s.aspect_ratio }};
    --sbc-radius: {{ s.image_radius }}px;
    --sbc-h-d: {{ s.heading_size_desktop }}px;
    --sbc-h-m: {{ s.heading_size_mobile }}px;
    --sbc-title-color: {{ s.title_color }};
    --sbc-title-size: {{ s.title_size }}px;
    --sbc-title-ls: {{ ls }}em;
    --sbc-pt-d: {{ s.padding_top }}px;
    --sbc-pb-d: {{ s.padding_bottom }}px;
    --sbc-pt-m: {{ s.padding_top_mobile }}px;
    --sbc-pb-m: {{ s.padding_bottom_mobile }}px;
  "
>
  <section class="tnl-sbc__inner" aria-labelledby="{{ heading_id }}">
    <div class="tnl-sbc__head">
      <div class="tnl-sbc__head-text">
        {%- if s.eyebrow != blank -%}
          <p class="tnl-sbc__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="tnl-sbc__heading" id="{{ heading_id }}">{{ s.heading }}</h2>
        {%- endif -%}
      </div>

      <div class="tnl-sbc__actions">
        {%- if s.show_view_all and s.view_all_text != blank -%}
          <a href="{{ view_all_url }}" class="tnl-sbc__view-all">{{ s.view_all_text }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if s.collections.size > 0 -%}
      <div class="tnl-sbc__grid">
        {%- for collection in s.collections -%}
          {%- assign card_image = collection.featured_image -%}
          {%- assign card_attrs = '' -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.collection.handle == collection.handle and block.settings.custom_image != blank -%}
              {%- assign card_image = block.settings.custom_image -%}
              {%- assign card_attrs = block.shopify_attributes -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign card_alt = card_image.alt | default: collection.title -%}
          {%- assign ph_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          {%- assign ph_name = 'collection-' | append: ph_index -%}
          <a href="{{ collection.url }}" class="tnl-sbc__card" {{ card_attrs }}>
            <span class="tnl-sbc__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1000
                  | image_tag:
                    widths: '400, 600, 800, 1000',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 75vw',
                    alt: card_alt,
                    loading: 'lazy',
                    class: 'tnl-sbc__img'
                }}
              {%- else -%}
                <span class="tnl-sbc__ph" aria-hidden="true">
                  {{ ph_name | placeholder_svg_tag: 'tnl-sbc__ph-svg' }}
                </span>
              {%- endif -%}
            </span>
            {%- if s.show_titles -%}
              <span class="tnl-sbc__title">{{ collection.title }}</span>
            {%- else -%}
              <span class="tnl-sbc__sr">{{ collection.title }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="tnl-sbc__empty">Select collections in this section's settings to display them here.</p>
    {%- endif -%}
  </section>
</div>

{% stylesheet %}
  .tnl-sbc {
    --sbc-cream: #0E0E0E;
    --sbc-font-head: var(--font-anton, 'Anton');
    --sbc-font-mono: var(--font-jetbrains-mono, 'JetBrains Mono'), monospace;

    --sbc-fg-eff: var(--sbc-fg, var(--sbc-cream));
    --sbc-gutter: var(--sbc-gutter-m);
    --sbc-gap: var(--sbc-gap-m);
    --sbc-pt: var(--sbc-pt-m);
    --sbc-pb: var(--sbc-pb-m);
    --sbc-h: var(--sbc-h-m);
    --sbc-cols: var(--sbc-cols-m);

    display: block;
    background: var(--sbc-bg, #FFFFFF);
    color: var(--sbc-fg-eff);
    padding-block: var(--sbc-pt) var(--sbc-pb);
    overflow: hidden;
    box-sizing: border-box;
  }
  .tnl-sbc *, .tnl-sbc *::before, .tnl-sbc *::after { box-sizing: border-box; }

  .tnl-sbc__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 46px;
    max-width: var(--sbc-maxw);
    margin-inline: auto;
    padding-inline: var(--sbc-gutter);
    gap: 16px;
  }

  .tnl-sbc__eyebrow {
    font: 700 10px var(--sbc-font-mono);
    letter-spacing: .12em;
    margin: 0 0 18px;
    text-transform: uppercase;
    color: var(--sbc-fg-eff);
  }

  .tnl-sbc__heading {
    font-family: var(--sbc-font-head);
    font-weight: 400;
    font-size: var(--sbc-h);
    line-height: .82;
    letter-spacing: -.04em;
    margin: 0;
    text-transform: uppercase;
    color: var(--sbc-fg-eff);
  }

  .tnl-sbc__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
    padding-bottom: 6px;
  }

  .tnl-sbc__view-all {
    font: 700 11px var(--sbc-font-mono);
    display: flex;
    gap: 7px;
    align-items: center;
    border-bottom: 2px solid currentColor;
    padding-bottom: 5px;
    white-space: nowrap;
    color: var(--sbc-fg-eff);
    text-decoration: none;
    text-transform: uppercase;
  }

  .tnl-sbc__grid {
    display: grid;
    grid-template-columns: repeat(var(--sbc-cols), minmax(0, 1fr));
    gap: calc(var(--sbc-gap) * 1.5) var(--sbc-gap);
    max-width: var(--sbc-maxw);
    margin-inline: auto;
    padding-inline: var(--sbc-gutter);
  }
  .tnl-sbc__card:focus-visible { outline: 2px solid var(--sbc-fg-eff); outline-offset: 4px; }

  .tnl-sbc__card {
    display: block;
    min-width: 0;
    color: var(--sbc-fg-eff);
    text-decoration: none;
  }

  .tnl-sbc__media {
    display: block;
    position: relative;
    aspect-ratio: var(--sbc-ratio);
    overflow: hidden;
    border-radius: var(--sbc-radius);
    background: rgb(255 255 255 / 0.06);
  }

  .tnl-sbc__img,
  .tnl-sbc__ph,
  .tnl-sbc__ph-svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
  }
  .tnl-sbc__img {
    object-fit: cover !important;
    object-position: 50% 50% !important;
    transition: transform 0.5s ease;
  }
  .tnl-sbc__ph-svg { fill: currentColor; opacity: 0.12; }

  .tnl-sbc__title {
    display: block;
    margin-top: 10px;
    font-family: var(--sbc-font-mono);
    font-weight: 700;
    font-size: var(--sbc-title-size);
    letter-spacing: var(--sbc-title-ls);
    line-height: 1.2;
    color: var(--sbc-title-color, #0E0E0E);
    text-transform: none;
  }
  .tnl-sbc__sr {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .tnl-sbc__empty {
    max-width: var(--sbc-maxw); margin: 0 auto; padding-inline: var(--sbc-gutter);
    font: 400 14px/1.4 var(--sbc-font-mono); opacity: 0.7;
  }

  @media (hover: hover) {
    .tnl-sbc[data-hover="true"] .tnl-sbc__card:hover .tnl-sbc__img,
    .tnl-sbc[data-hover="true"] .tnl-sbc__card:hover .tnl-sbc__ph { transform: scale(1.04); }
    .tnl-sbc[data-hover="true"] .tnl-sbc__title { text-underline-offset: 5px; }
    .tnl-sbc[data-hover="true"] .tnl-sbc__card:hover .tnl-sbc__title { text-decoration: underline; }
  }

  /* Tablet */
  @media (min-width: 750px) {
    .tnl-sbc {
      --sbc-gutter: var(--sbc-gutter-d);
      --sbc-gap: var(--sbc-gap-d);
      --sbc-pt: var(--sbc-pt-d);
      --sbc-pb: var(--sbc-pb-d);
      --sbc-h: calc(var(--sbc-h-m) + (var(--sbc-h-d) - var(--sbc-h-m)) / 2);
      --sbc-cols: var(--sbc-cols-t);
    }
  }

  /* Desktop */
  @media (min-width: 990px) {
    .tnl-sbc {
      --sbc-h: var(--sbc-h-d);
      --sbc-cols: var(--sbc-cols-d);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tnl-sbc__img { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by collection",
  "tag": "div",
  "class": "tnl-sbc-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP BY COLLECTION" },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "info": "Add, remove and drag to reorder. Up to 50. To use your own image for one, add a Custom image block below.",
      "limit": 50
    },
    { "type": "checkbox", "id": "show_titles", "label": "Show collection titles", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View All", "default": true },
    { "type": "text", "id": "view_all_text", "label": "View All text", "default": "VIEW ALL ↗" },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All link",
      "info": "Leave empty to link to the collections list page."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "cols_desktop",
      "label": "Desktop: cards per view",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "cols_tablet",
      "label": "Tablet: cards per view",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "cols_mobile",
      "label": "Mobile: cards per row",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "2 / 3", "label": "Tall 2:3" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape 4:3" }
      ],
      "default": "4 / 5"
    },
    { "type": "range", "id": "gap_desktop", "label": "Gap between cards (tablet & desktop)", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "gap_mobile", "label": "Gap between cards (mobile)", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "max_width", "label": "Maximum section width", "min": 1200, "max": 2400, "step": 100, "unit": "px", "default": 1600 },
    { "type": "range", "id": "gutter_desktop", "label": "Side padding (tablet & desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "gutter_mobile", "label": "Side padding (mobile)", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_top", "label": "Top padding (tablet & desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (tablet & desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },

    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#0E0E0E" },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF",
      "info": "Leave empty to use the theme's black."
    },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 140, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "color", "id": "title_color", "label": "Collection title color", "default": "#FFFFFF" },
    { "type": "range", "id": "title_size", "label": "Collection title size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Collection title letter spacing",
      "info": "In hundredths of an em (4 = 0.04em).",
      "min": -5,
      "max": 30,
      "step": 1,
      "default": 4
    },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "hover_effect", "label": "Hover effect (desktop)", "default": true }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "collection",
      "name": "Custom image",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Must also be selected in the Collections list above." },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Image",
          "info": "Replaces this collection's featured image on its card."
        }
      ]
    }
  ],
  "presets": [{ "name": "Shop by collection" }]
}
{% endschema %}