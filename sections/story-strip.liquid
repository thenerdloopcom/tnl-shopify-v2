<section class="story-strip">
  <div>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }} <span>{{ section.settings.accent }}</span></h2>
  </div>

  <p>{{ section.settings.text }}</p>

  <a href="{{ section.settings.button_link | default: routes.root_url }}" class="comic-button dark">
    {{ section.settings.button_label }} ↗
  </a>
</section>

{% schema %}
{
  "name": "Story strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE CRAFT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HANDMADE" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "IN INDIA." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every mask is hand-stitched, every poster is QC'd by fans, and every metallic item is crafted for durability. We don't just sell items; we sell pieces of the universe you love." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "READ THE STORY" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Story strip" }]
}
{% endschema %}
