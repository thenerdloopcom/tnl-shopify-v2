{%- assign col = section.settings.collection | default: collections['all'] -%}

<section id="shop" class="shop-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }} <span>{{ section.settings.accent }}</span></h2>
    </div>
    <a href="{{ col.url }}" class="text-link">SHOP ALL ↗</a>
  </div>

  <div class="product-grid">
    {%- for product in col.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <div class="empty-shop" style="grid-column:1/-1">DROPPING SOON IN THE LOOP.</div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE VAULT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ALL" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "COLLECTION" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
