{%- comment -%} Featured product card — compact product meta with quick-view bag trigger. {%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
<article class="product-card">
  <a href="{{ product.url }}" class="card-image">
    <div class="product-art">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
      {%- endif -%}
      {%- if product.tags contains 'customize-it' -%}
        <span class="customize-tag">CUSTOMIZE IT →</span>
      {%- endif -%}
    </div>
  </a>

  <div class="card-info card-info--quick-view">
    <a href="{{ product.url }}" class="card-product-meta">
      <h3>{{ product.title }}</h3>
      <strong>{{ v.price | money_without_trailing_zeros }}</strong>
    </a>

    {%- if product.available -%}
      <button
        type="button"
        class="quick-view-trigger"
        data-quick-view="{{ product.url }}?view=quick-view"
        aria-label="Quick view {{ product.title | escape }}"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}
      </button>
    {%- else -%}
      <span class="quick-view-trigger quick-view-trigger--disabled" aria-label="Sold out">
        {{ 'icon-cart.svg' | inline_asset_content }}
      </span>
    {%- endif -%}
  </div>
</article>
