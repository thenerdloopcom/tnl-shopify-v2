{%- comment -%} Usage: {% render 'product-card', product: product %} {%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
<article class="product-card">
  <a href="{{ product.url }}" class="card-image">
    <div class="product-art">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
      {%- endif -%}
      {%- if product.tags contains 'customize-it' -%}
        <span class="customize-tag">CUSTOMIZE IT →</span>
      {%- endif -%}
    </div>
  </a>

  <a href="{{ product.url }}" class="card-info">
    <div>
      <p class="eyebrow">{{ product.type }}</p>
      <h3>{{ product.title }}</h3>
      {%- if product.metafields.custom.subtitle != blank -%}
        <p class="subtitle">{{ product.metafields.custom.subtitle }}</p>
      {%- endif -%}
    </div>
    <strong>{{ v.price | money_without_trailing_zeros }}</strong>
  </a>

  <div class="card-actions">
    {%- if product.available == false -%}
      <button type="button" class="add-button" disabled>SOLD OUT</button>

    {%- elsif product.has_only_default_variant -%}
      <button type="button" class="add-button" data-add="{{ v.id }}">ADD TO BAG ↗</button>

      {%- if product.tags contains 'customize-it' -%}
        <a href="{{ product.url }}" class="add-button buy-now-card">
          <span>BUY NOW</span><span>→</span>
        </a>
      {%- else -%}
        <form action="{{ routes.cart_add_url }}" method="post" class="buy-now-form">
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="/checkout">
          <button type="submit" class="add-button buy-now-card">
            <span>BUY NOW</span><span>→</span>
          </button>
        </form>
      {%- endif -%}

    {%- else -%}
      <a href="{{ product.url }}" class="add-button">CHOOSE OPTIONS ↗</a>
    {%- endif -%}
  </div>
</article>
