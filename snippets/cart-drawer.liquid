<div class="drawer-backdrop" data-drawer hidden>
  <aside class="cart-drawer" role="dialog" aria-modal="true" aria-label="Your bag">
    <div class="drawer-head">
      <h2>YOUR <span>BAG</span></h2>
      <button type="button" data-drawer-close aria-label="Close cart">✕</button>
    </div>

    <div class="cart-items" data-cart-items></div>

    <div class="drawer-footer" data-cart-footer hidden>
      <div class="drawer-total">
        <span>TOTAL</span>
        <span data-cart-total></span>
      </div>
      <a href="/checkout" class="checkout-button w-full">PROCEED TO CHECKOUT ↗</a>
    </div>
  </aside>
</div>
